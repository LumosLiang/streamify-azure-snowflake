# Reuse Java and SPARK_HOME installed by scripts/spark_setup.sh.
source "$HOME/.spark_env"

# Spark Standalone and Kafka
export SPARK_MASTER_URL="spark://<spark-master-private-ip>:7077"
export KAFKA_ADDRESS="<kafka-private-ip>"

# Polaris Spark principal and catalog
export POLARIS_SPARK_CLIENT_ID="<polaris-spark-client-id>"
export POLARIS_SPARK_CLIENT_SECRET="<polaris-spark-client-secret>"
export POLARIS_CATALOG_NAME="<polaris-catalog-name>"

# Spark Structured Streaming checkpoint
export ICEBERG_CHECKPOINT_STORAGE_ACCOUNT="<iceberg-storage-account-name>"
